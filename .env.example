# =========================================================================
# COSTA RICA TOURS 2026 - VARIABLES DE ENTORNO
# =========================================================================

# GEMINI_API_KEY: Inyectada automáticamente por Google AI Studio.
GEMINI_API_KEY=""

# APP_URL: URL base pública del entorno activo.
APP_URL=""

# FIRESTORE_DATABASE_ID: Base de datos provisionada en Google Cloud.
FIRESTORE_DATABASE_ID=""

# PROYECTO GOOGLE CLOUD
GCP_PROJECT=""
GOOGLE_CLOUD_PROJECT=""

# =========================================================================
# SEGURIDAD Y FIRMAS INTERNAS (Valores por defecto para desarrollo)
# =========================================================================
PAYMENT_HMAC_SECRET=""
OPERATOR_API_KEY=""
WEBHOOK_SECRET=""
# Secret used to sign short-lived provider portal links (required for secure provider forms).
PROVIDER_ACTION_SECRET=""

# =========================================================================
# ALERTAS Y NOTIFICACIONES DE OPERADORES
# =========================================================================
ADMIN_ALERT_EMAIL=""
# WhatsApp del operador para notificaciones internas (Cloud API/Twilio/Webhook si está configurado).
OWNER_WHATSAPP_NUMBER="50687959148"
# WhatsApp Business inbound webhook (Meta Cloud API)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
PROVIDER_DEV_EMAIL=""
DISABLE_PROVIDER_EMAIL_OVERRIDE="false"

# =========================================================================
# PAGOS Y LIQUIDACIONES A PROVEEDORES
# =========================================================================
# Fail-closed: mantener false hasta verificar PayPal live, proveedores, comisiones
# y el ciclo completo reserva -> servicio prestado -> liquidación.
ENABLE_PROVIDER_PAYOUTS="false"
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_MODE="sandbox"

# Tipo de cambio de referencia USD -> CRC. En producción debe ser configurado/actualizado desde una fuente oficial.
USD_TO_CRC_RATE=""
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""
AGENT_INTERNAL_TOKEN=""

# Durable Customer Intake queue processor (scheduler/internal worker)
CUSTOMER_INTAKE_JOB_TOKEN=""

# Cloud Scheduler -> private Cloud Run automation sweeps (dedicated least-privilege identity)
SCHEDULER_REGION="us-central1"
SCHEDULER_SERVICE_ACCOUNT=""
CLOUD_RUN_BACKEND_URL=""

# Optional private emergency operations contact. Public responses always include 9-1-1.
EMERGENCY_CONTACT_PHONE=""

# Optional SINPE Mobile number used for payment instructions; never hardcode it in source.
SINPE_MOBILE_NUMBER=""

# Portable Voice Agent Desk / Twilio-compatible Voice webhooks
# Keep false until a real provider number, callbacks, and an end-to-end call are verified.
VOICE_AGENT_DESK_ENABLED=false
VOICE_PROVIDER_AUTH_TOKEN=""
PUBLIC_BASE_URL=""
# Optional E.164 human destinations, comma-separated (maximum 8).
VOICE_HUMAN_NUMBERS=""
# Backward-compatible single-number setting; prefer VOICE_HUMAN_NUMBERS.
VOICE_HUMAN_NUMBER=""
VOICE_HUMAN_LABEL="Agent Desk humano"

# Agente autónomo omnicanal de correo (Gmail OAuth / Microsoft Graph OAuth)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_INBOX_USER="me"
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
OUTLOOK_REFRESH_TOKEN=""
OUTLOOK_TENANT_ID="common"
OUTLOOK_MAILBOX_USER=""

# Escalamiento y protección ante tráfico masivo
API_MAX_IN_FLIGHT=80
AI_MAX_IN_FLIGHT=10
BOOKING_MAX_IN_FLIGHT=12
INTAKE_MAX_IN_FLIGHT=12

# Resiliencia del agente de correo
EMAIL_FETCH_CONCURRENCY=6
EMAIL_MAX_ATTEMPTS=5

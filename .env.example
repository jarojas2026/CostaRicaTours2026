# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# n8n Automation & Webhook Configuration
N8N_BASE_URL="https://tu-instancia-n8n.com"
N8N_WEBHOOK_SECRET="tu-secreto-compartido-webhook"
N8N_API_KEY=""
N8N_BOOKING_WEBHOOK_URL="https://costaricatours.app.n8n.cloud/webhook/reserva-confirmada"
N8N_CHAT_WEBHOOK_URL="https://costaricatours.app.n8n.cloud/webhook/chat-consulta"
VITE_N8N_WEBHOOK_URL=""
VITE_N8N_API_KEY=""

# Firestore & Cloud Database Configuration
FIRESTORE_DATABASE_ID="ai-studio-costaricatours-88d81273-09f7-4f87-991c-60b9b0db0dea"
FIREBASE_SERVICE_ACCOUNT=

# Stripe Configuration
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
N8N_BOOKING_WEBHOOK_URL="https://costaricatours.app.n8n.cloud/webhook/mi-api"
PAYPAL_CLIENT_ID="YOUR_PAYPAL_CLIENT_ID"
PAYPAL_SECRET="YOUR_PAYPAL_SECRET"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# Google Maps Configuration
VITE_GOOGLE_MAPS_API_KEY=
PAYPAL_MODE="sandbox"

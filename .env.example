# GEMINI_API_KEY: Clave obligatoria para el Asistente AI y motor cognitivo con Gemini 2.5 Flash / Pro.
# Google AI Studio la inyecta automáticamente en runtime.
GEMINI_API_KEY=""

# APP_URL: URL base pública donde está desplegada la aplicación (ej: https://costaricatours.com).
# Usada para enlaces de confirmación, webhooks y callbacks de pasarelas de pago.
APP_URL=""

# =========================================================================
# FIREBASE & FIRESTORE
# =========================================================================
# FIREBASE_SERVICE_ACCOUNT: JSON string con credenciales de la cuenta de servicio de Firebase Admin SDK.
FIREBASE_SERVICE_ACCOUNT=""

# FIRESTORE_DATABASE_ID: Identificador de la base de datos Firestore (opcional si es "(default)").
FIRESTORE_DATABASE_ID=""

# FIREBASE_API_KEY: Clave de API de Firebase Web Client (si se usa inicialización directa en cliente).
FIREBASE_API_KEY=""

# =========================================================================
# n8n AUTOMATION & WEBHOOKS (costaricatours2026.app.n8n.cloud)
# =========================================================================
# N8N_ENABLED: Activa el reenvío hacia workflows de n8n ("true" / "false").
N8N_ENABLED="true"

# N8N_BASE_URL: URL base de la instancia de n8n.
N8N_BASE_URL="https://costaricatours2026.app.n8n.cloud"

# N8N_WEBHOOK_SECRET: Secreto compartido enviado en cabecera 'X-Webhook-Secret' para autenticar llamadas de entrada/salida.
N8N_WEBHOOK_SECRET=""

# N8N_API_KEY: Clave de API para invocar endpoints de gestión en n8n.
N8N_API_KEY=""

# N8N_MCP_SERVER_URL: URL HTTP del servidor MCP (Model Context Protocol) en n8n.
N8N_MCP_SERVER_URL="https://costaricatours2026.app.n8n.cloud/mcp-server/http"

# N8N_MCP_TOKEN: Bearer token JWT para autorizar llamadas a través del MCP Server de n8n.
N8N_MCP_TOKEN=""

# Webhooks de workflows específicos en n8n:
N8N_BOOKING_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/reserva-confirmada"
N8N_CHAT_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/chat-consulta"
N8N_PROVIDER_NOTIFY_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/notificar-proveedor"
N8N_ANTIFRAUD_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/evaluar-antifraude"
N8N_SINPE_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/cr-tours-sinpe-verify"
N8N_MULTICHANNEL_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/notificaciones-multicanal"
N8N_CALENDAR_SYNC_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/sync-google-calendar"
N8N_TELEGRAM_OPS_WEBHOOK_URL="https://costaricatours2026.app.n8n.cloud/webhook/telegram-ops-action"

# Variables de prueba en frontend de n8n (opcionales):
VITE_N8N_WEBHOOK_URL=""
VITE_N8N_API_KEY=""
VITE_N8N_BASE_URL=""
VITE_N8N_WEBHOOK_SECRET=""
VITE_API_BASE_URL=""

# =========================================================================
# TELEGRAM OPERATIVO (Canal legacy de notificaciones de emergencia)
# =========================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID="-1002489148001"
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_OPS_CHAT_ID=""

# =========================================================================
# PASARELAS DE PAGO Y FIRMAS DE SEGURIDAD
# =========================================================================
# PAYMENT_HMAC_SECRET: Secreto criptográfico para generar y validar hashes HMAC-SHA256 en tokens de pago y reservas.
PAYMENT_HMAC_SECRET=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_MODE="sandbox" # "sandbox" o "live"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLIC_KEY=""

# =========================================================================
# SEGURIDAD Y ACCESO DE OPERADORES
# =========================================================================
# OPERATOR_API_KEY: Clave de API para autenticar operadores y agentes en endpoints protegidos (/api/bookings, /api/alerts, etc.).
OPERATOR_API_KEY=""

# WEBHOOK_SECRET: Secreto general de fallback para validación de webhooks entrantes.
WEBHOOK_SECRET=""

# =========================================================================
# SISTEMA PROPIO DE ALERTAS ADMINISTRATIVAS (Reemplazo de Telegram)
# =========================================================================
# ADMIN_ALERT_EMAIL: Correo del operador/administrador que recibe alertas críticas del sistema.
ADMIN_ALERT_EMAIL=""

# Credenciales SMTP para envío de alertas y notificaciones (Gmail SMTP o servidor dedicado):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Proveedores de correo alternativos (opcionales):
EMAIL_FROM="reservas@costaricatours.com"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# =========================================================================
# MODELOS ADICIONALES (Claude en Vertex AI / Google Cloud) - Opcionales
# =========================================================================
GCP_PROJECT=""
GOOGLE_CLOUD_PROJECT=""
ANTHROPIC_VERTEX_PROJECT_ID=""
ANTHROPIC_VERTEX_REGION="us-east5"
ANTHROPIC_VERTEX_MODEL="claude-3-5-sonnet@20240620"
CLOUD_ML_REGION=""
VERTEX_AI_REGION=""

# =========================================================================
# GOOGLE MAPS PLATFORM (Frontend)
# =========================================================================
VITE_GOOGLE_MAPS_API_KEY=""


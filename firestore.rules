rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isOwner() {
      return isSignedIn() && (
        request.auth.token.role == 'owner' ||
        request.auth.token.owner == true
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isOwner() ||
        (request.auth.token.role == 'admin' || request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'createdAt', 'email', 'displayName'])
        && data.userId == request.auth.uid
        && data.userId is string && data.userId.size() <= 128
        && (data.createdAt == request.time || data.createdAt == existing().createdAt)
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256));
    }

    // isValidBooking was removed: the bookings ledger is written only by the
    // backend (Firebase Admin) and by admins, so a client-side shape validator
    // was dead code that suggested browser writes were allowed.

    function isValidReview(data) {
      return data.keys().hasAll(['bookingId', 'userId', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['bookingId', 'userId', 'rating', 'comment', 'createdAt', 'tourId', 'authorName'])
        && data.userId == request.auth.uid
        && data.bookingId is string && data.bookingId.size() <= 128
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 2048
        && (data.createdAt == request.time || data.createdAt == existing().createdAt)
        && (!('tourId' in data) || (data.tourId is string && data.tourId.size() <= 128))
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 256));
    }

    // Health check / connection test
    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId && isValidId(userId)) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if (isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming()) && incoming().userId == existing().userId) || isAdmin();
    }
    
    match /bookings/{bookingId} {
      // Travelers may read their own reservation, but all writes to the
      // authoritative booking ledger are server/admin owned. Firebase Admin
      // bypasses Security Rules, so canonical backend booking/payment/provider
      // lifecycle operations keep working without allowing a browser to forge
      // paymentStatus, totals, provider evidence, payout state or confirmation.
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /escalations/{escalationId} {
      allow read, write: if isAdmin();
    }

    match /admin_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Only the traveler who owns the referenced booking may review it.
      allow create: if isSignedIn()
        && isValidReview(incoming())
        && isValidId(incoming().bookingId)
        && exists(/databases/$(database)/documents/bookings/$(incoming().bookingId))
        && get(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chat_sessions/{sessionId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // userId is immutable: a session can never be re-assigned to another user.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    // Digital Agent Office control-plane documents are server-owned.
    // Firebase Admin is the only writer; browser clients can only observe them
    // after passing the existing administrator gate. Phase 3 narrows sensitive
    // governance mutations further to the owner role.
    match /agents/{agentId} {
      allow read: if isAdmin() && isValidId(agentId);
      allow create, update, delete: if false;
    }

    match /agentRuns/{runId} {
      allow read: if isAdmin() && isValidId(runId);
      allow create, update, delete: if false;

      match /steps/{stepId} {
        allow read: if isAdmin() && isValidId(stepId);
        allow create, update, delete: if false;
      }
    }

    match /agent_governance/{controlId} {
      allow read: if isAdmin() && isValidId(controlId);
      allow create, update, delete: if false;
    }

    match /jarvis_plans/{planId} {
      allow read: if isOwner() && isValidId(planId);
      allow create, update, delete: if false;
    }

    match /agent_approvals/{approvalId} {
      allow read: if isOwner() && isValidId(approvalId);
      allow create, update, delete: if false;
    }

    match /agent_audit_log/{auditId} {
      allow read: if isOwner() && isValidId(auditId);
      allow create, update, delete: if false;
    }

    match /agent_memory/{sessionId} {
      allow read, write: if isSignedIn() && request.auth.uid == sessionId;
    }
  }
}

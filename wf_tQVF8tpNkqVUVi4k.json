    {
      "parameters": {
        "jsCode": "const LF = String.fromCharCode(10);\nconst items = $input.all().map(i => i.json);\nconst lineas = items.map(b => `• ${b.bookingId} — ${b.tourName || 'tour'} — ${b.customer?.name || 'sin nombre'} (${b.customer?.email || 'sin email'}) — creada ${b.createdAt}`);\nconst mensaje = [\n  '🚨 Reservas atascadas en pago (2h+ sin confirmar):',\n  '',\n  ...lineas,\n  '',\n  'Revisar manualmente: ¿el cliente abandonó el pago o falló algo en el servidor?'\n].join(LF);\nreturn [{ json: { mensaje, ids: items.map(b => b.bookingId) } }];"
      },

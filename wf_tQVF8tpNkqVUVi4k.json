    {
      "parameters": {
        "jsCode": "const DOS_HORAS_MS = 2 * 60 * 60 * 1000;\nconst ahora = Date.now();\n\nreturn $input.all()\n  .filter(i => Object.keys(i.json).length > 0)\n  .filter(i => (i.json.stuckAlertSent || false) !== true)\n  .filter(i => {\n    const creado = new Date(i.json.createdAt || 0).getTime();\n    return !isNaN(creado) && (ahora - creado) >= DOS_HORAS_MS;\n  })\n  .map(i => ({ json: i.json }));"
      },

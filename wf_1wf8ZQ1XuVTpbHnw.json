    {
      "id": "828ccad4-5f1d-4f96-b556-8fe7f9d0c00b",
      "name": "Extraer Datos de la Reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = .first().json.body || {};\nconst booking = body.booking || {};\nconst customer = booking.customer || {};\n\n// Asignación por defecto o normalización de proveedores verificados (Alsama Tours CR, Expediciones Tropicales)\nlet providerId = booking.providerId || 'proveedor-directo-crtours';\nif (!booking.providerId && booking.tourName) {\n  const t = booking.tourName.toLowerCase();\n  if (t.includes('arenal') || t.includes('fortuna') || t.includes('sarapiquí') || t.includes('sarapiqui')) {\n    providerId = 'alsama-tours-cr';\n  } else if (t.includes('tortuguero') || t.includes('café') || t.includes('poas') || t.includes('doka')) {\n    providerId = 'expediciones-tropicales';\n  }\n}\n\nreturn [{\n  json: {\n    bookingId: booking.bookingId || '',\n    providerId: providerId,\n    tourName: booking.tourName || 'Tour en Costa Rica',\n    date: booking.date || '',\n    time: booking.time || '',\n    adults: booking.adults || 1,\n    children: booking.children || 0,\n    pickupHotel: booking.pickupHotel || 'Por confirmar',\n    specialRequests: booking.specialRequests || 'Ninguna',\n    customerName: customer.name || booking.customerName || 'Viajero',\n    customerPhone: customer.phone || booking.customerPhone || 'Sin teléfono',\n  }\n}];"
      }
    },
    {
      "id": "eb6d11ba-cdf8-43b9-b889-b06268d6f0f3",
      "name": "Obtener Proveedor",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [
        448,
        192
      ],
      "parameters": {
        "resource": "document",
        "operation": "get",
        "authentication": "serviceAccount",
        "projectId": "gen-lang-client-0782739149",
        "collection": "providers",
        "documentId": "={{ $json.providerId }}",
        "simple": true
      }
    },
    {
      "id": "f1c9d17d-eec4-4293-824d-06f353475720",
      "name": "¿Proveedor Activo Con Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "activo",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {

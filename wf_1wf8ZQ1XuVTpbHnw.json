                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "36eb79fe-190c-495f-832e-a2186f48b8d7",
      "name": "Notificar Proveedor por Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "=Nueva reserva confirmada: {{ $(\"Extraer Datos de la Reserva\").item.json.tourName }}",
        "emailType": "html",
        "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color:#0A2315;\">Nueva reserva confirmada — prepárense 🌴</h2>\n  <table style=\"width:100%; border-collapse: collapse;\">\n    <tr><td style=\"padding:6px 0;\"><strong>Tour:</strong></td><td>{{ $('Extraer Datos de la Reserva').item.json.tourName }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Fecha:</strong></td><td>{{ $('Extraer Datos de la Reserva').item.json.date }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Hora:</strong></td><td>{{ $('Extraer Datos de la Reserva').item.json.time }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Pasajeros:</strong></td><td>{{ $('Extraer Datos de la Reserva').item.json.adults }} adulto(s), {{ $('Extraer Datos de la Reserva').item.json.children }} niño(s)</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Punto de recogida:</strong></td><td>{{ $('Extraer Datos de la Reserva').item.json.pickupHotel }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Contacto cliente:</strong></td><td>{{ $('Extraer Datos de la Reserva').item.json.customerName }} — {{ $('Extraer Datos de la Reserva').item.json.customerPhone }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>N° de reserva:</strong></td><td>{{ $('Extraer Datos de la Reserva').item.json.bookingId }}</td></tr>\n  </table>\n  <p style=\"color:#888; font-size:12px; margin-top:20px;\">Costa Rica Tours — coordinación automática de reservas</p>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput",
      "webhookId": "d6bf33af-9c2d-4ad7-ae25-9373f71e0018"
    },
    {
      "id": "93ab38bf-ddef-48c0-9f41-613187f5bb0e",

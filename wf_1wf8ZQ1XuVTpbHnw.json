    {
      "id": "0c9a4da8-6c65-4b10-8c10-7fa1f2bfa24c",
      "name": "Webhook: Notificar Proveedor",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        192
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "notificar-proveedor",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "webhookId": "e2022bb0-f474-415a-8102-d076ac347d60",
      "credentials": {
        "httpHeaderAuth": {
          "id": "5NiYz8gX64lPYIdK",
          "name": "Header Auth account"
        }
      }

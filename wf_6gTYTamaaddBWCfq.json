        "jsCode": "const b = $input.first().json; const q = (b.texto || b.mensaje || \"\").toLowerCase(); let codRegion = \"ARENAL\"; if (q.includes(\"monteverde\")) codRegion = \"MONTEVERDE\"; else if (q.includes(\"manuel antonio\") || q.includes(\"quepos\")) codRegion = \"MANUEL_ANTONIO\"; else if (q.includes(\"tortuguero\") || q.includes(\"caribe\")) codRegion = \"CARIBE_TORTUGUERO\"; else if (q.includes(\"guanacaste\") || q.includes(\"tamarindo\")) codRegion = \"GUANACASTE\"; else if (q.includes(\"corcovado\") || q.includes(\"osa\")) codRegion = \"OSA_PACIFICO_SUR\"; return [{ json: { ...b, codRegion } }];"
      }

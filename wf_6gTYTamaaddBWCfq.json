        "jsCode": "const b = $input.first().json.body || $input.first().json || {}; const texto = (b.texto || b.mensaje || \"\").toLowerCase(); let perfil = \"Explorador Aventura\"; if (texto.includes(\"niño\") || texto.includes(\"familia\") || texto.includes(\"abuelo\")) perfil = \"Familiar / Accesible\"; else if (texto.includes(\"lujo\") || texto.includes(\"privado\") || texto.includes(\"vip\")) perfil = \"Lujo Sostenible VIP\"; else if (texto.includes(\"pajaro\") || texto.includes(\"ave\") || texto.includes(\"quetzal\") || texto.includes(\"rana\")) perfil = \"Ecoturismo / Birdwatching\"; return [{ json: { ...b, perfilDetectado: perfil } }];"

{
  "name": "costa-rica-tours-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run audit:system && vite build && node scripts/auditOperatorPrivacy.mjs dist && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "catalog:build": "python3 scripts/catalog/build_operator_tours.py && python3 scripts/catalog/scrub_public_map_layers.py && python3 scripts/catalog/strip_public_business_contacts.py && python3 scripts/catalog/write_tour_redirects.py && tsx scripts/generateSitemap.ts",
    "audit:operator-privacy": "node scripts/auditOperatorPrivacy.mjs dist",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:contracts": "node --test-force-exit --import ./tests/offlineEnv.mjs --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "audit:security:prod": "npm audit --omit=dev --audit-level=high",
    "audit:whatsapp": "tsx scripts/auditCustomerWhatsAppRouting.ts",
    "audit:system": "tsx scripts/auditSystem.ts",
    "sitemap": "tsx scripts/generateSitemap.ts",
    "check:release": "npm run audit:security:prod && node scripts/securityFixtureAudit.mjs && npm run audit:whatsapp && npm run test:contracts && node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit && npm run build",
    "ops:scheduler:plan": "tsx scripts/configureOperationalScheduler.ts",
    "ops:scheduler:apply": "tsx scripts/configureOperationalScheduler.ts --apply"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.21.0",
    "@google/genai": "^2.30.0",
    "@sentry/node": "^11.9.0",
    "@sentry/react": "^11.8.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^13.5.1",
    "googleapis": "^186.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.58.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^24.0.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "gaxios@6": {
      "uuid": "^11.1.1"
    },
    "@types/express-serve-static-core": "5.1.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}

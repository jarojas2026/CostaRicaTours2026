{
  "name": "CostaRicaTours - 02. Verificacion SINPE Movil",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cr-tours-sinpe-verify",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook-sinpe",
      "name": "Webhook: SINPE Check",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "cr-tours-sinpe-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.sinpeReference }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "node-check-ref",
      "name": "¿Comprobante Válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://firestore.googleapis.com/v1/projects/{{ $env.FIREBASE_PROJECT_ID || 'gen-lang-client-0782739149' }}/databases/(default)/documents/bookings/{{ $json.body.bookingId }}?updateMask.fieldPaths=status&updateMask.fieldPaths=paymentStatus&updateMask.fieldPaths=sinpeReference&updateMask.fieldPaths=paymentVerifiedAt",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.FIREBASE_AUTH_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fields\": {\n    \"status\": { \"stringValue\": \"confirmada\" },\n    \"paymentStatus\": { \"stringValue\": \"completed\" },\n    \"sinpeReference\": { \"stringValue\": \"{{ $json.body.sinpeReference }}\" },\n    \"paymentVerifiedAt\": { \"stringValue\": \"{{ $now.toISO() }}\" }\n  }\n}"
      },
      "id": "node-update-firebase",
      "name": "Actualizar Estado en Firestore",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_URL || 'https://api.whatsapp.com/v1/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Webhook: SINPE Check').item.json.body.customerPhone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"✅ *¡Pago SINPE Móvil Verificado!*\\n\\nHemos validado tu comprobante (Ref: {{ $('Webhook: SINPE Check').item.json.body.sinpeReference }}) para la reserva *#{{ $('Webhook: SINPE Check').item.json.body.bookingId }}*.\\n\\nTu espacio está 100% asegurado y confirmado. ¡Nos vemos en el tour!\"\n  }\n}"
      },
      "id": "node-notify-verified",
      "name": "Aviso WhatsApp: Pago Confirmado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [920, 240]
    }
  ],
  "connections": {
    "Webhook: SINPE Check": {
      "main": [
        [
          {
            "node": "¿Comprobante Válido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Comprobante Válido?": {
      "main": [
        [
          {
            "node": "Actualizar Estado en Firestore",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Actualizar Estado en Firestore": {
      "main": [
        [
          {
            "node": "Aviso WhatsApp: Pago Confirmado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}

    { "parameters": { "jsCode": "const DOS_HORAS_MS = 2 * 60 * 60 * 1000;\nconst ahora = Date.now();\n\nreturn $input.all()\n  .filter(i => Object.keys(i.json).length > 0)\n  .filter(i => (i.json.stuckAlertSent || false) !== true)\n  .filter(i => {\n    const creado = new Date(i.json.createdAt || 0).getTime();\n    return !isNaN(creado) && (ahora - creado) >= DOS_HORAS_MS;\n  })\n  .map(i => ({ json: i.json }));" }, "id": "66ee2987-f2ec-47c3-832a-29328b07a1d5", "name": "Filtrar Reservas Atascadas (2h+)", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [448, 176] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $input.all().length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }] }, "options": {} }, "id": "bea6cd23-12f5-45bc-9111-14203991ac04", "name": "¿Hay Reservas Atascadas?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [672, 0] },
    { "parameters": { "jsCode": "const LF = String.fromCharCode(10);\nconst items = $input.all().map(i => i.json);\nconst lineas = items.map(b => `• ${b.bookingId} — ${b.tourName || 'tour'} — ${b.customer?.name || 'sin nombre'} (${b.customer?.email || 'sin email'}) — creada ${b.createdAt}`);\nconst mensaje = [\n  '🚨 Reservas atascadas en pago (2h+ sin confirmar):',\n  '',\n  ...lineas,\n  '',\n  'Revisar manualmente: ¿el cliente abandonó el pago o falló algo en el servidor?'\n].join(LF);\nreturn [{ json: { mensaje, ids: items.map(b => b.bookingId) } }];" }, "id": "b1e4e7dd-b03d-4098-ab3e-fdd3ffdd2099", "name": "Armar Mensaje de Alerta", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [896, 0] },
    { "parameters": { "chatId": "PENDIENTE_CONFIGURAR_CHAT_ID", "text": "={{ $json.mensaje }}", "additionalFields": { "appendAttribution": false } }, "id": "b76229de-08c2-4260-beef-15aa535f1f4a", "name": "Avisar por Telegram", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1120, 0] },

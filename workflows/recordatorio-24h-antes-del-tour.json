{
  "id": "LwgnVnKikhxucZ6U",
  "name": "Recordatorio 24h Antes del Tour",
  "active": false,
  "description": "Cada día a las 7am busca tours confirmados para mañana y envía un recordatorio por email al cliente con hora y punto de recogida, evitando duplicados con la marca reminderSent.",
  "settings": { "executionOrder": "v1" },
  "connections": {
    "Disparador Diario 7am (Costa Rica)": { "main": [[{ "node": "Buscar Reservas Confirmadas", "type": "main", "index": 0 }]] },
    "Buscar Reservas Confirmadas": { "main": [[{ "node": "Filtrar Tours de Mañana", "type": "main", "index": 0 }]] },
    "Filtrar Tours de Mañana": { "main": [[{ "node": "Bucle Reservas de Mañana", "type": "main", "index": 0 }]] },
    "¿Reserva Tiene Email?": { "main": [[{ "node": "Enviar Recordatorio por Email", "type": "main", "index": 0 }], [{ "node": "Avisar Reserva Sin Email (Telegram)", "type": "main", "index": 0 }]] },
    "Enviar Recordatorio por Email": { "main": [[{ "node": "Preparar Actualización", "type": "main", "index": 0 }], [{ "node": "Avisar Fallo de Recordatorio (Telegram)", "type": "main", "index": 0 }]] },
    "Preparar Actualización": { "main": [[{ "node": "Marcar Recordatorio Enviado", "type": "main", "index": 0 }]] },
    "Marcar Recordatorio Enviado": { "main": [[{ "node": "Bucle Reservas de Mañana", "type": "main", "index": 0 }]] },
    "Bucle Reservas de Mañana": { "main": [[], [{ "node": "¿Reserva Tiene Email?", "type": "main", "index": 0 }]] },
    "Avisar Fallo de Recordatorio (Telegram)": { "main": [[{ "node": "Bucle Reservas de Mañana", "type": "main", "index": 0 }]] },
    "Avisar Reserva Sin Email (Telegram)": { "main": [[{ "node": "Bucle Reservas de Mañana", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    { "id": "4241ded3-7ce3-4f02-a690-c0ba57b3759a", "name": "Disparador Diario 7am (Costa Rica)", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.4, "position": [0, 480], "parameters": { "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 7, "triggerAtMinute": 0 }] } } },
    { "id": "e5d01aa9-82f3-4165-a85c-5665b2b7edaa", "name": "Buscar Reservas Confirmadas", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [224, 480], "parameters": { "resource": "document", "operation": "query", "authentication": "serviceAccount", "projectId": "gen-lang-client-0782739149", "query": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"bookings\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"confirmada\"}}}}}", "simple": true } },
    { "id": "c96ad3c5-1772-4375-85a1-6e79456256c0", "name": "Filtrar Tours de Mañana", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [448, 480], "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const manana = new Date();\nmanana.setDate(manana.getDate() + 1);\nconst mananaStr = manana.toISOString().slice(0, 10);\n\nreturn $input.all()\n  .filter(i => Object.keys(i.json).length > 0)\n  .filter(i => (i.json.reminderSent || false) !== true)\n  .filter(i => {\n    const fecha = String(i.json.date || '').slice(0, 10);\n    return fecha === mananaStr;\n  })\n  .map(i => ({ json: i.json }));" } },
    { "id": "dd995591-9342-467c-a742-dc2dbd789c4f", "name": "¿Reserva Tiene Email?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [896, 192], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.customer.email }}", "operator": { "type": "string", "operation": "notEmpty" } }] } } },
    { "id": "a7cb1bf0-70d3-40ab-9a57-d97bd2cecf59", "name": "Enviar Recordatorio por Email", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [1120, 96], "parameters": { "resource": "message", "operation": "send", "sendTo": "={{ $json.customer.email }}", "subject": "=¡Tu tour es mañana! {{ $json.tourName }} - Costa Rica Tours", "emailType": "html", "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color:#0A2315;\">¡Pura Vida, {{ $json.customer.name }}! 🌴</h2>\n  <p>Este es un recordatorio de que tu tour es <strong>mañana</strong>:</p>\n  <table style=\"width:100%; border-collapse: collapse;\">\n    <tr><td style=\"padding:6px 0;\"><strong>Tour:</strong></td><td>{{ $json.tourName }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Fecha:</strong></td><td>{{ $json.date }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Hora de recogida:</strong></td><td>{{ $json.time }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Punto de recogida:</strong></td><td>{{ $json.pickupHotel }}</td></tr>\n  </table>\n  <p style=\"margin-top:16px;\">Recomendaciones: ropa cómoda, protector solar, repelente de insectos y muchas ganas de disfrutar. ¡Nos vemos mañana!</p>\n  <p style=\"color:#888; font-size:12px;\">Costa Rica Tours — 100% Tico</p>\n</div>", "options": { "appendAttribution": false } }, "onError": "continueErrorOutput" },
    { "id": "d5669323-1e9a-4dda-b290-c9ae7c5bbfd6", "name": "Preparar Actualización", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [1344, 0], "parameters": { "mode": "manual", "assignments": { "assignments": [{ "id": "a-id", "name": "id", "type": "string", "value": "={{ $('Bucle Reservas de Mañana').item.json.bookingId }}" }, { "id": "a-sent", "name": "reminderSent", "type": "boolean", "value": true }, { "id": "a-at", "name": "reminderSentAt", "type": "string", "value": "={{ $now.toISO() }}" }] } } },
    { "id": "6d73cf62-c681-492e-ac90-59755dcbdd08", "name": "Marcar Recordatorio Enviado", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [1568, 272], "parameters": { "resource": "document", "operation": "upsert", "authentication": "serviceAccount", "projectId": "gen-lang-client-0782739149", "collection": "bookings", "updateKey": "id", "columns": "id,reminderSent,reminderSentAt" } },
    { "id": "3453339e-19bb-45ad-8c2e-2977f71e1ca0", "name": "Bucle Reservas de Mañana", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [672, 480], "parameters": { "batchSize": 1 } },
    { "id": "c074ca96-7cd1-4579-9b7c-659bcb898754", "name": "Avisar Fallo de Recordatorio (Telegram)", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1344, 192], "parameters": { "resource": "message", "operation": "sendMessage", "chatId": "PENDIENTE_CONFIGURAR_CHAT_ID", "text": "=⚠️ No se pudo enviar el recordatorio de la reserva {{ $('Bucle Reservas de Mañana').item.json.bookingId }}. Revisar manualmente antes del tour de mañana.", "additionalFields": { "appendAttribution": false } } },
    { "id": "005040b7-c9d4-4a72-8fd7-a59cb86934dc", "name": "Avisar Reserva Sin Email (Telegram)", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1120, 288], "parameters": { "resource": "message", "operation": "sendMessage", "chatId": "PENDIENTE_CONFIGURAR_CHAT_ID", "text": "=ℹ️ La reserva {{ $json.bookingId }} (tour mañana) no tiene email. Avisar manualmente al cliente.", "additionalFields": { "appendAttribution": false } } }
  ]
}

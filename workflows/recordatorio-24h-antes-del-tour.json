  "nodes": [
    {
      "id": "4241ded3-7ce3-4f02-a690-c0ba57b3759a",
      "name": "Disparador Diario 7am (Costa Rica)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 480],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "e5d01aa9-82f3-4165-a85c-5665b2b7edaa",
      "name": "Buscar Reservas Confirmadas",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [224, 480],
      "parameters": {
        "resource": "document",
        "operation": "query",
        "authentication": "serviceAccount",
        "projectId": "gen-lang-client-0782739149",
        "query": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"bookings\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"confirmada\"}}}}}",
        "simple": true
      }
    },
    {
      "id": "c96ad3c5-1772-4375-85a1-6e79456256c0",
      "name": "Filtrar Tours de Mañana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 480],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const manana = new Date();\nmanana.setDate(manana.getDate() + 1);\nconst mananaStr = manana.toISOString().slice(0, 10);\n\nreturn $input.all()\n  .filter(i => Object.keys(i.json).length > 0)\n  .filter(i => (i.json.reminderSent || false) !== true)\n  .filter(i => {\n    const fecha = String(i.json.date || '').slice(0, 10);\n    return fecha === mananaStr;\n  })\n  .map(i => ({ json: i.json }));"
      }
    },
    {
      "id": "3453339e-19bb-45ad-8c2e-2977f71e1ca0",
      "name": "Bucle Reservas de Mañana",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [672, 480],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "dd995591-9342-467c-a742-dc2dbd789c4f",
      "name": "¿Reserva Tiene Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [896, 192],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.customer?.email || $json.customerEmail }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "a7cb1bf0-70d3-40ab-9a57-d97bd2cecf59",
      "name": "Enviar Recordatorio por Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1120, 96],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.customer?.email || $json.customerEmail }}",
        "subject": "=🌿 ¡Tu tour es mañana! {{ $json.tourName }} - Costa Rica Tours",
        "emailType": "html",
        "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #1e293b; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;\">\n  <div style=\"background: linear-gradient(135deg, #059669, #047857); padding: 24px; text-align: center; color: white;\">\n    <h2 style=\"margin: 0;\">¡Pura Vida, {{ $json.customer?.name || $json.customerName || 'Viajero' }}! 🌴</h2>\n    <p style=\"margin: 6px 0 0 0; opacity: 0.95;\">Tu aventura comienza mañana</p>\n  </div>\n  <div style=\"padding: 24px;\">\n    <p>Este es un recordatorio de que tu tour está programado para <strong>mañana</strong>:</p>\n    <table style=\"width:100%; border-collapse: collapse; margin-bottom: 16px;\">\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding:8px 0; color:#64748b;\">Tour:</td><td style=\"padding:8px 0; font-weight: bold; text-align: right;\">{{ $json.tourName }}</td></tr>\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding:8px 0; color:#64748b;\">Fecha:</td><td style=\"padding:8px 0; font-weight: bold; text-align: right;\">{{ $json.date }}</td></tr>\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding:8px 0; color:#64748b;\">Hora de Recogida:</td><td style=\"padding:8px 0; font-weight: bold; text-align: right;\">{{ $json.time }}</td></tr>\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding:8px 0; color:#64748b;\">Punto de Recogida:</td><td style=\"padding:8px 0; font-weight: bold; text-align: right;\">{{ $json.pickupHotel }}</td></tr>\n      <tr><td style=\"padding:8px 0; color:#64748b;\">N° de Reserva:</td><td style=\"padding:8px 0; text-align: right;\">#{{ $json.bookingId }}</td></tr>\n    </table>\n    <div style=\"background: #f8fafc; border-left: 4px solid #059669; padding: 14px; border-radius: 4px;\">\n      <strong>🌿 Recomendaciones clave:</strong> Ropa cómoda y ligera, zapatos cerrados de buena tracción, protector solar biodegradable, repelente de insectos y tu botella de agua reutilizable.\n    </div>\n    <p style=\"margin-top:20px; font-size: 13px; color: #64748b;\">Tu guía estará en la recepción a la hora indicada. Si necesitas ajustar algún detalle, escríbenos al WhatsApp de asistencia 24/7.</p>\n  </div>\n  <div style=\"background: #f1f5f9; padding: 12px; text-align: center; font-size: 11px; color: #64748b;\">\n    Costa Rica Tours — 100% Pura Vida\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "d5669323-1e9a-4dda-b290-c9ae7c5bbfd6",
      "name": "Preparar Actualización",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1344, 0],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a-id",
              "name": "id",
              "type": "string",
              "value": "={{ $('Bucle Reservas de Mañana').item.json.bookingId }}"
            },
            {
              "id": "a-sent",
              "name": "reminderSent",
              "type": "boolean",
              "value": true
            },
            {
              "id": "a-at",
              "name": "reminderSentAt",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      }
    },
    {
      "id": "6d73cf62-c681-492e-ac90-59755dcbdd08",
      "name": "Marcar Recordatorio Enviado",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [1568, 272],
      "parameters": {
        "resource": "document",
        "operation": "upsert",
        "authentication": "serviceAccount",
        "projectId": "gen-lang-client-0782739149",
        "collection": "bookings",
        "updateKey": "id",
        "columns": "id,reminderSent,reminderSentAt"
      }
    },
    {
      "id": "c074ca96-7cd1-4579-9b7c-659bcb898754",
      "name": "Avisar Fallo de Recordatorio (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1344, 192],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID || '-1002489148001' }}",
        "text": "=⚠️ No se pudo enviar el recordatorio por email de la reserva {{ $('Bucle Reservas de Mañana').item.json.bookingId }}. Contactar manualmente al cliente antes del tour de mañana.",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "005040b7-c9d4-4a72-8fd7-a59cb86934dc",
      "name": "Avisar Reserva Sin Email (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 288],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID || '-1002489148001' }}",
        "text": "=ℹ️ La reserva {{ $json.bookingId }} (tour mañana: {{ $json.tourName }}) no tiene email registrado. Enviar recordatorio por WhatsApp.",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ]
}

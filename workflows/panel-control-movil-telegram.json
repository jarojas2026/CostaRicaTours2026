    {
      "id": "3c98b671-558e-4a62-a279-d58e3981ac12",
      "name": "Parsear Comando",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const msg = $input.first().json.message || {};\nconst text = String(msg.text || '').trim();\nconst chatId = msg.chat?.id || '';\n\nconst parts = text.split(/\\s+/);\nlet rawCmd = (parts[0] || '').toLowerCase().replace('/', '').split('@')[0];\nconst arg = parts.slice(1).join(' ').trim();\n\nconst validCommands = ['hoy', 'reservas', 'buscar', 'confirmar', 'alertas', 'ayuda', 'start'];\nif (!validCommands.includes(rawCmd)) {\n  rawCmd = 'ayuda';\n}\nif (rawCmd === 'start') {\n  rawCmd = 'ayuda';\n}\n\nreturn [{\n  json: {\n    command: rawCmd,\n    arg: arg,\n    chatId: String(chatId),\n    user: msg.from?.first_name || 'Operador'\n  }\n}];"
      }
    },
    {
      "id": "f5195ea1-455b-4229-87a3-e71167732a90",
      "name": "Enrutar Comando",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        448,
        480
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "hoy",
                    "operator": {

    {
      "id": "73412a76-9235-4901-e465-2d567890123e",
      "name": "Formatear Detalle de Reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $input.first().json;\nconst searchedId = $('Parsear Comando').item.json.arg;\nconst LF = String.fromCharCode(10);\nlet msg = '';\nif (!b || !b.bookingId) {\n  msg = `🔍 No se encontró ninguna reserva con el identificador \"${searchedId}\". Verifica el código e intenta nuevamente.`;\n} else {\n  msg = [\n    `🔍 Detalle de Reserva: ${b.bookingId}`,\n    `• Tour: ${b.tourName || 'Tour'}`,\n    `• Fecha y Hora: ${b.date} ${b.time || ''}`,\n    `• Estado: ${b.status}`,\n    `• Total: $${b.totalUSD} USD`,\n    `• Pasajeros: ${b.adults || 1} adultos, ${b.children || 0} niños`,\n    `• Hotel recogida: ${b.pickupHotel || 'No especificado'}`,\n    `• Cliente: ${b.customer?.name || 's/n'} (${b.customer?.email || 's/e'})`,\n    `• Teléfono: ${b.customer?.phone || 's/t'}`,\n    `• Proveedor: ${b.providerId || 'No asignado'}`,\n  ].join(LF);\n}\nreturn [{ json: { text: msg, chatId: $('Parsear Comando').item.json.chatId } }];"
      }
    },

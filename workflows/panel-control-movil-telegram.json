    {
      "id": "4921ca87-0b1a-4712-9c1e-36fa89c091d3",
      "name": "Formatear Tours de Hoy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const hoyStr = new Date().toISOString().slice(0, 10);\nconst items = $input.all().filter(i => Object.keys(i.json).length > 0).map(i => i.json);\nconst toursHoy = items.filter(b => String(b.date || '').slice(0, 10) === hoyStr);\n\nconst LF = String.fromCharCode(10);\nlet msg = '';\nif (toursHoy.length === 0) {\n  msg = `🌴 No hay tours programados para hoy (${hoyStr}).`;\n} else {\n  const lines = toursHoy.map((b, idx) => {\n    const p = (parseInt(b.adults || 1, 10) + parseInt(b.children || 0, 10));\n    return `${idx + 1}. [${b.time || 'Hora s/d'}] ${b.tourName || 'Tour'} — ${p} pax — Hotel: ${b.pickupHotel || 'Por confirmar'} (Reserva: ${b.bookingId})`;\n  });\n  msg = [`🌴 Tours programados para HOY (${hoyStr}):`, ...lines].join(LF);\n}\nreturn [{ json: { text: msg, chatId: $('Parsear Comando').item.json.chatId } }];"
      }
    },

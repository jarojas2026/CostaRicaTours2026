      "name": "Formatear Reservas Recientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all().filter(i => Object.keys(i.json).length > 0).map(i => i.json);\nconst LF = String.fromCharCode(10);\nlet msg = '';\nif (items.length === 0) {\n  msg = 'No se encontraron reservas en el sistema.';\n} else {\n  const lines = items.slice(0, 8).map(b => {\n    const cliente = b.customer?.name || 'Cliente';\n    return `• ${b.bookingId}: ${b.tourName || 'Tour'} | ${b.date} | $${b.totalUSD} USD [${b.status}] - ${cliente}`;\n  });\n  msg = ['📋 Últimas reservas registradas:', ...lines].join(LF);\n}\nreturn [{ json: { text: msg, chatId: $('Parsear Comando').item.json.chatId } }];"
      }
    },

  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "reserva-confirmada", "authentication": "headerAuth", "responseMode": "responseNode", "options": {} }, "id": "df8666e5-da5c-4838-b510-21ddf894449f", "name": "Webhook: Reserva Confirmada", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [0, 192] },
    { "parameters": { "jsCode": "const body = $input.first().json.body || {};\nconst booking = body.booking || {};\nconst customer = booking.customer || {};\nreturn [{\n  json: {\n    bookingId: booking.bookingId || '',\n    tourName: booking.tourName || 'tu tour',\n    date: booking.date || '',\n    time: booking.time || '',\n    pickupHotel: booking.pickupHotel || 'tu hotel',\n    totalUSD: booking.totalUSD || 0,\n    adults: booking.adults || 1,\n    children: booking.children || 0,\n    customerName: customer.name || 'Viajero',\n    customerEmail: customer.email || '',\n  }\n}];" }, "id": "e5d6bd06-2d13-4234-81d5-d66328326512", "name": "Extraer Datos de la Reserva", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [224, 192] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.customerEmail }}", "operator": { "type": "string", "operation": "notEmpty" } }] }, "options": {} }, "id": "c19021f9-cbb7-4951-8a06-fb56c0ca9f3a", "name": "¿Cliente Tiene Email?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [448, 192] },
    { "parameters": { "sendTo": "={{ $json.customerEmail }}", "subject": "=¡Reserva confirmada! {{ $json.tourName }} - Costa Rica Tours", "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color:#0A2315;\">¡Pura Vida, {{ $json.customerName }}! 🌴</h2>\n  <p>Tu reserva quedó <strong>confirmada</strong>. Aquí el resumen:</p>\n  <table style=\"width:100%; border-collapse: collapse;\">\n    <tr><td style=\"padding:6px 0;\"><strong>Tour:</strong></td><td>{{ $json.tourName }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Fecha:</strong></td><td>{{ $json.date }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Hora:</strong></td><td>{{ $json.time }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Recogida en:</strong></td><td>{{ $json.pickupHotel }}</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Pasajeros:</strong></td><td>{{ $json.adults }} adulto(s), {{ $json.children }} niño(s)</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>Total pagado:</strong></td><td>${{ $json.totalUSD }} USD</td></tr>\n    <tr><td style=\"padding:6px 0;\"><strong>N° de reserva:</strong></td><td>{{ $json.bookingId }}</td></tr>\n  </table>\n  <p style=\"margin-top:20px;\">Te escribiremos de nuevo un día antes de tu tour con los últimos detalles. ¡Nos vemos pronto!</p>\n  <p style=\"color:#888; font-size:12px;\">Costa Rica Tours — 100% Tico</p>\n</div>", "options": { "appendAttribution": false } }, "id": "660ce4cd-448a-443f-9a26-8f10b7bdf66a", "name": "Enviar Confirmación por Email", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [672, 96], "onError": "continueErrorOutput" },
    { "parameters": { "respondWith": "json", "responseBody": "={{ { \"received\": true } }}", "options": {} }, "id": "6679ecd4-4d9b-4cd3-9595-9fe92c14fdb8", "name": "Responder OK", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [896, 0] },
    { "parameters": { "chatId": "PENDIENTE_CONFIGURAR_CHAT_ID", "text": "=⚠️ No se pudo enviar el email de confirmación de la reserva {{ $json.bookingId }} a {{ $json.customerEmail }}. Revisar manualmente.", "additionalFields": { "appendAttribution": false } }, "id": "69b755c6-cdab-45d3-9a23-bd9d65cbb08e", "name": "Avisar Fallo de Email (Telegram)", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [896, 192] },
    { "parameters": { "respondWith": "json", "responseBody": "={{ { \"received\": true, \"emailError\": true } }}", "options": {} }, "id": "480cf75a-2ba4-43d4-99fa-4e8dd36b8902", "name": "Responder OK (fallo email)", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [1120, 192] },
    { "parameters": { "chatId": "PENDIENTE_CONFIGURAR_CHAT_ID", "text": "=ℹ️ La reserva {{ $json.bookingId }} de {{ $json.customerName }} no tiene email registrado. No se envió confirmación automática.", "additionalFields": { "appendAttribution": false } }, "id": "2bab9040-8487-4637-b557-bfc5020e10dc", "name": "Avisar Reserva Sin Email (Telegram)", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [672, 384] },
    { "parameters": { "respondWith": "json", "responseBody": "={{ { \"received\": true, \"email\": false } }}", "options": {} }, "id": "81f5ed68-3e9a-4a50-a2a3-0868a4f2bded", "name": "Responder OK (sin email)", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [896, 384] }
  ]
}

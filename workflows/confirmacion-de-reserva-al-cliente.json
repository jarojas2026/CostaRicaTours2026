      "name": "Webhook: Reserva Confirmada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 192]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst booking = body.booking || {};\nconst customer = booking.customer || {};\n\nreturn [{\n  json: {\n    bookingId: booking.bookingId || '',\n    tourName: booking.tourName || 'tu experiencia en Costa Rica',\n    date: booking.date || '',\n    time: booking.time || '',\n    pickupHotel: booking.pickupHotel || 'Recepción del hotel',\n    totalUSD: booking.totalUSD || 0,\n    adults: booking.adults || 1,\n    children: booking.children || 0,\n    customerName: customer.name || booking.customerName || 'Viajero Pura Vida',\n    customerEmail: customer.email || booking.customerEmail || '',\n    voucherUrl: `https://costaricatours.com/voucher/${booking.bookingId || ''}`\n  }\n}];"
      },
      "id": "e5d6bd06-2d13-4234-81d5-d66328326512",
      "name": "Extraer Datos de la Reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 192]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.customerEmail }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "c19021f9-cbb7-4951-8a06-fb56c0ca9f3a",
      "name": "¿Cliente Tiene Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 192]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.customerEmail }}",
        "subject": "=🌿 ¡Reserva Confirmada! {{ $json.tourName }} (#{{ $json.bookingId }}) - Costa Rica Tours",
        "emailType": "html",
        "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #1e293b; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;\">\n  <div style=\"background: linear-gradient(135deg, #059669, #047857); padding: 28px; text-align: center; color: white;\">\n    <h1 style=\"margin: 0; font-size: 24px;\">¡Pura Vida, {{ $json.customerName }}! 🌴</h1>\n    <p style=\"margin: 8px 0 0 0; opacity: 0.95;\">Tu reserva está 100% confirmada</p>\n  </div>\n  <div style=\"padding: 24px;\">\n    <p style=\"font-size: 16px; margin-top: 0;\">Hemos recibido tu pago correctamente y tu espacio está reservado con nuestro guía naturalista oficial:</p>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding: 8px 0; color: #64748b;\">N° de Reserva:</td><td style=\"padding: 8px 0; font-weight: bold; text-align: right;\">#{{ $json.bookingId }}</td></tr>\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding: 8px 0; color: #64748b;\">Tour:</td><td style=\"padding: 8px 0; font-weight: bold; text-align: right;\">{{ $json.tourName }}</td></tr>\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding: 8px 0; color: #64748b;\">Fecha y Hora:</td><td style=\"padding: 8px 0; font-weight: bold; text-align: right;\">{{ $json.date }} a las {{ $json.time }}</td></tr>\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding: 8px 0; color: #64748b;\">Punto de Recogida:</td><td style=\"padding: 8px 0; font-weight: bold; text-align: right;\">{{ $json.pickupHotel }}</td></tr>\n      <tr style=\"border-bottom: 1px solid #f1f5f9;\"><td style=\"padding: 8px 0; color: #64748b;\">Pasajeros:</td><td style=\"padding: 8px 0; font-weight: bold; text-align: right;\">{{ $json.adults }} Adulto(s), {{ $json.children }} Niño(s)</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #64748b;\">Total Pagado:</td><td style=\"padding: 8px 0; font-size: 18px; font-weight: bold; color: #059669; text-align: right;\">${{ $json.totalUSD }} USD</td></tr>\n    </table>\n    <div style=\"background: #f8fafc; border-left: 4px solid #059669; padding: 14px; border-radius: 4px; margin-bottom: 24px;\">\n      <strong>🌿 Qué llevar:</strong> Ropa cómoda y fresca, zapatos cerrados de senderismo, repelente biodegradable, bloqueador solar y botella de agua reutilizable.\n    </div>\n    <p style=\"color: #64748b; font-size: 14px;\">Te enviaremos un recordatorio 24 horas antes con los últimos detalles de tu guía y chofer.</p>\n  </div>\n  <div style=\"background: #f1f5f9; padding: 16px; text-align: center; font-size: 12px; color: #64748b;\">\n    Costa Rica Tours · Turismo Sostenible Certificado (CST) · Soporte 24/7 WhatsApp: +506 8795-9148\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "660ce4cd-448a-443f-9a26-8f10b7bdf66a",
      "name": "Enviar Confirmación por Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [672, 96],
      "onError": "continueErrorOutput"

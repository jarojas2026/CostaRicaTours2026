    { "id": "55c47985-03f6-4368-b243-34e3a5f883b8", "name": "Consultar Escalaciones de la Corrida", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [1120, 0], "parameters": { "resource": "document", "operation": "query", "authentication": "serviceAccount", "projectId": "gen-lang-client-0782739149", "query": "={\"structuredQuery\":{\"from\":[{\"collectionId\":\"escalations\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"executionId\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"{{ $execution.id }}\"}}}}}", "simple": true }, "executeOnce": true },
    { "id": "1ec11b85-0bf4-49e4-94d9-29e3d89a7c85", "name": "Consultar Reservas Pagadas de la Corrida", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [1344, 0], "parameters": { "resource": "document", "operation": "query", "authentication": "serviceAccount", "projectId": "gen-lang-client-0782739149", "query": "={\"structuredQuery\":{\"from\":[{\"collectionId\":\"bookings\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"payoutExecutionId\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"{{ $execution.id }}\"}}}}}", "simple": true }, "executeOnce": true, "alwaysOutputData": true },
    { "id": "061a8021-c796-4d16-9fb3-109c93d55dd7", "name": "Construir Resumen", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1568, 0], "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const esc = $('Consultar Escalaciones de la Corrida').all().filter(i => Object.keys(i.json).length > 0);\nconst pagadas = $('Consultar Reservas Pagadas de la Corrida').all().filter(i => Object.keys(i.json).length > 0);\nconst LF = String.fromCharCode(10);\nconst lineas = esc.map(function (i) {\n  const e = i.json;\n  return '\u2022 Reserva ' + (e.bookingId || 's/n') + ' [' + (e.tipo || 'desconocido') + ']: ' + (e.detalle || '');\n});\nconst mensaje = 'Resumen de pagos a proveedores' + LF +\n  'Fecha: ' + new Date().toISOString() + LF + LF +\n  'Pagadas correctamente: ' + pagadas.length + LF +\n  'Pendientes de revisión: ' + esc.length + LF + LF +\n  'Detalle de escalaciones:' + LF + lineas.join(LF);\nreturn [{ json: { pagadas: pagadas.length, pendientes: esc.length, mensaje: mensaje } }];" } },
    { "id": "82d1f080-593c-4b4b-b9d2-106c40df7cd0", "name": "¿Hubo Escalaciones?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [1792, 0], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "combinator": "and", "conditions": [{ "id": "cond-esc", "leftValue": "={{ $json.pendientes }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }] } } },
    { "id": "5a12d759-a0b6-4937-b580-acc8c12c17f4", "name": "Enviar Resumen por Telegram", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [2016, 0], "parameters": { "resource": "message", "operation": "sendMessage", "chatId": "<__PLACEHOLDER_VALUE__Chat ID de Telegram para el resumen__>", "text": "={{ $json.mensaje }}", "additionalFields": { "appendAttribution": false } }, "executeOnce": true },
    { "id": "d85aa556-259e-4a51-b75e-98c3e94f1d14", "name": "Obtener Proveedor", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [896, 480], "parameters": { "resource": "document", "operation": "get", "authentication": "serviceAccount", "projectId": "gen-lang-client-0782739149", "collection": "providers", "documentId": "={{ $json.providerId }}", "simple": true }, "onError": "continueErrorOutput" },
    { "id": "3b7117c7-edf0-40e7-84ea-3c2325c17de4", "name": "¿Proveedor Tiene PayPal?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [1120, 384], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "combinator": "and", "conditions": [{ "id": "cond-paypal", "leftValue": "={{ $json.paypalEmail }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } }] } } },
    { "id": "c9c4d2ad-163b-424c-979c-56b9686a7e76", "name": "Calcular Monto a Pagar", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1344, 288], "parameters": { "mode": "runOnceForEachItem", "language": "javaScript", "jsCode": "const booking = $('Bucle Reservas Por Pagar').item.json;\nconst provider = $('Obtener Proveedor').item.json;\nconst total = parseFloat(String(booking.totalUSD).replace(/[^0-9.\\-]/g, '')) || 0;\nconst rate = parseFloat(provider.commissionRate) || 0;\nconst amount = total * (1 - rate);\nreturn { json: {\n  docId: booking._id,\n  bookingId: booking.bookingId,\n  providerId: booking.providerId,\n  providerName: provider.name,\n  paypalEmail: provider.paypalEmail,\n  totalUSD: total,\n  commissionRate: rate,\n  amount: amount.toFixed(2),\n} };" } },
    { "id": "151d0719-048d-46dc-881a-967924d82ee9", "name": "Enviar Pago PayPal", "type": "n8n-nodes-base.payPal", "typeVersion": 1, "position": [1568, 288], "parameters": { "resource": "payout", "operation": "create", "senderBatchId": "=payout-{{ $json.bookingId }}-{{ $now.toMillis() }}", "jsonParameters": false, "itemsUi": { "itemsValues": [{ "recipientType": "email", "receiverValue": "={{ $json.paypalEmail }}", "currency": "USD", "amount": "={{ $json.amount }}", "note": "=Pago del tour - reserva {{ $json.bookingId }}", "senderItemId": "={{ $json.bookingId }}", "recipientWallet": "paypal" }] }, "additionalFields": {} }, "onError": "continueErrorOutput" },
    { "id": "982cf97a-f50c-446c-bf16-f40c8fa4f2a3", "name": "Preparar Actualización Reserva", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [1792, 192], "parameters": { "mode": "manual", "assignments": { "assignments": [{ "id": "a-id", "name": "id", "type": "string", "value": "={{ $('Calcular Monto a Pagar').item.json.docId }}" }, { "id": "a-status", "name": "payoutStatus", "type": "string", "value": "pagado" }, { "id": "a-tx", "name": "payoutTxId", "type": "string", "value": "={{ $json.batch_header.payout_batch_id }}" }, { "id": "a-exec", "name": "payoutExecutionId", "type": "string", "value": "={{ $execution.id }}" }, { "id": "a-paid", "name": "paidAt", "type": "string", "value": "={{ $now.toISO() }}" }] }, "options": {} } },
    { "id": "ae9def10-586f-4c46-92c7-db5cdbe45e6e", "name": "Marcar Reserva Como Pagada", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [2016, 560], "parameters": { "resource": "document", "operation": "upsert", "authentication": "serviceAccount", "projectId": "gen-lang-client-0782739149", "collection": "bookings", "updateKey": "id", "columns": "payoutStatus,payoutTxId,payoutExecutionId,paidAt" } },

    { "id": "52766284-c989-44bf-8493-4498e3f7100e", "name": "Buscar Reservas Confirmadas", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [224, 912], "parameters": { "resource": "document", "operation": "query", "authentication": "serviceAccount", "projectId": "gen-lang-client-0782739149", "query": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"bookings\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"confirmada\"}}}}}", "simple": true } },
    { "id": "63387e4a-84d4-46c0-bd06-199d1950de25", "name": "Filtrar Reservas Listas Para Pagar", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [448, 912], "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const startOfToday = new Date();\nstartOfToday.setHours(0, 0, 0, 0);\nreturn $input.all()\n  .filter(i => Object.keys(i.json).length > 0)\n  .filter(i => (i.json.payoutStatus || '') !== 'pagado')\n  .filter(i => {\n    const d = new Date(i.json.date);\n    return !isNaN(d.getTime()) && d < startOfToday;\n  })\n  .map(i => ({ json: i.json }));" } },

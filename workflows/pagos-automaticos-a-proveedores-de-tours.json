    { "id": "24338042-3714-4a46-b2c1-24fdbe2c45fa", "name": "Preparar Escalación: Pago Fallido", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [1792, 480], "parameters": { "mode": "manual", "assignments": { "assignments": [{ "id": "e3-booking", "name": "bookingId", "type": "string", "value": "={{ $('Calcular Monto a Pagar').item.json.bookingId }}" }, { "id": "e3-provider", "name": "providerId", "type": "string", "value": "={{ $('Calcular Monto a Pagar').item.json.providerId }}" }, { "id": "e3-tipo", "name": "tipo", "type": "string", "value": "pago_fallido" }, { "id": "e3-detalle", "name": "detalle", "type": "string", "value": "=Falló el pago PayPal de {{ $('Calcular Monto a Pagar').item.json.amount }} USD a {{ $('Calcular Monto a Pagar').item.json.paypalEmail }}. Error: {{ $json.error && $json.error.message ? $json.error.message : 'error desconocido' }}" }, { "id": "e3-amount", "name": "amount", "type": "string", "value": "={{ $('Calcular Monto a Pagar').item.json.amount }}" }, { "id": "e3-exec", "name": "executionId", "type": "string", "value": "={{ $execution.id }}" }, { "id": "e3-created", "name": "createdAt", "type": "string", "value": "={{ $now.toISO() }}" }] }, "options": {} } },

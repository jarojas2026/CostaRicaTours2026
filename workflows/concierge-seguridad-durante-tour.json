{
  "id": "crt-during-sale-01",
  "name": "Concierge y Alerta de Seguridad Durante el Tour",
  "active": false,
  "description": "Monitorea tours programados para hoy y envía una recomendación meteorológica y de seguridad matutina personalizada al viajero según su destino (Arenal, Monteverde, Manuel Antonio).",
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Costa_Rica",
    "errorWorkflow": "CRT-ERR-01"
  },
  "connections": {
    "Disparador Diario 6am": {
      "main": [
        [
          {
            "node": "Buscar Tours de Hoy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Tours de Hoy": {
      "main": [
        [
          {
            "node": "Enviar Concierge Matutino",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "nodes": [
    {
      "id": "node-sched-during",
      "name": "Disparador Diario 6am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "node-fs-during",
      "name": "Buscar Tours de Hoy",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [224, 0],
      "parameters": {
        "resource": "document",
        "operation": "query",
        "authentication": "serviceAccount",
        "projectId": "gen-lang-client-0782739149",
        "query": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"bookings\"}],\"where\":{\"compositeFilter\":{\"op\":\"AND\",\"filters\":[{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"confirmada\"}}}]}},\"limit\":100}}",
        "simple": true
      },
      "credentials": {
        "googleFirebaseCloudFirestoreApi": {
          "id": "5NiYz8gX64lPYIdK",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "id": "node-code-during",
      "name": "Enviar Concierge Matutino",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const hoyStr = new Date().toISOString().slice(0, 10);\nconst items = $input.all().map(i => i.json).filter(b => String(b.date || '').slice(0, 10) === hoyStr);\n\nreturn items.map(item => ({\n  json: {\n    bookingId: item.bookingId,\n    customerName: item.customerName || 'Viajero',\n    customerEmail: item.customerEmail,\n    tourName: item.tourName,\n    conciergeTip: `¡Buenos días ${item.customerName || 'Viajero'}! Hoy es el gran día de tu experiencia: ${item.tourName}. Recuerda llevar ropa cómoda, protector solar biodegradable y llegar 15 minutos antes al punto de encuentro. Nuestro equipo de Costa Rica Tours te desea un día maravilloso y muy Pura Vida 🌿☀️.`\n  }\n}));"
      }
    }
  ]
}

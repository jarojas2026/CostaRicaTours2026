  "nodes": [
    {
      "id": "0c9a4da8-6c65-4b10-8c10-7fa1f2bfa24c",
      "name": "Webhook: Notificar Proveedor",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 192],
      "parameters": {
        "httpMethod": "POST",
        "path": "notificar-proveedor",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "crt-webhook-secret-auth",
          "name": "Costa Rica Tours - Webhook Auth"
        }
      }
    },
    {
      "id": "828ccad4-5f1d-4f96-b556-8fe7f9d0c00b",
      "name": "Extraer Datos de la Reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 192],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body || {};\nconst booking = body.booking || {};\nconst customer = booking.customer || {};\n\nreturn [{\n  json: {\n    bookingId: booking.bookingId || '',\n    providerId: booking.providerId || 'proveedor-directo-crtours',\n    tourName: booking.tourName || 'Tour en Costa Rica',\n    date: booking.date || '',\n    time: booking.time || '',\n    adults: booking.adults || 1,\n    children: booking.children || 0,\n    pickupHotel: booking.pickupHotel || 'Por confirmar',\n    specialRequests: booking.specialRequests || 'Ninguna',\n    customerName: customer.name || booking.customerName || 'Viajero',\n    customerPhone: customer.phone || booking.customerPhone || 'Sin teléfono',\n  }\n}];"
      }
    },
    {
      "id": "eb6d11ba-cdf8-43b9-b889-b06268d6f0f3",
      "name": "Obtener Proveedor",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [448, 192],
      "parameters": {
        "resource": "document",
        "operation": "get",
        "authentication": "serviceAccount",
        "projectId": "gen-lang-client-0782739149",
        "collection": "providers",
        "documentId": "={{ $json.providerId }}",
        "simple": true
      }
    },
    {
      "id": "f1c9d17d-eec4-4293-824d-06f353475720",
      "name": "¿Proveedor Activo Con Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [672, 192],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "activo",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "36eb79fe-190c-495f-832e-a2186f48b8d7",
      "name": "Notificar Proveedor por Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [896, 96],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "=🚐 Despacho de Servicio: Nueva reserva confirmada — {{ $(\"Extraer Datos de la Reserva\").item.json.tourName }} (#{{ $(\"Extraer Datos de la Reserva\").item.json.bookingId }})",
        "emailType": "html",
        "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #1e293b; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;\">\n  <div style=\"background: #0A2315; color: #fff; padding: 20px; text-align: center;\">\n    <h2 style=\"margin: 0;\">Nueva Reserva Confirmada — Asignación de Servicio 🌴</h2>\n    <p style=\"margin: 5px 0 0 0; opacity: 0.9;\">Costa Rica Tours · Coordinación Operativa</p>\n  </div>\n  <div style=\"padding: 20px;\">\n    <table style=\"width:100%; border-collapse: collapse;\">\n      <tr><td style=\"padding:8px 0; border-bottom: 1px solid #f1f5f9;\"><strong>Tour:</strong></td><td style=\"text-align: right;\">{{ $('Extraer Datos de la Reserva').item.json.tourName }}</td></tr>\n      <tr><td style=\"padding:8px 0; border-bottom: 1px solid #f1f5f9;\"><strong>Fecha y Hora:</strong></td><td style=\"text-align: right;\">{{ $('Extraer Datos de la Reserva').item.json.date }} a las {{ $('Extraer Datos de la Reserva').item.json.time }}</td></tr>\n      <tr><td style=\"padding:8px 0; border-bottom: 1px solid #f1f5f9;\"><strong>Pasajeros:</strong></td><td style=\"text-align: right;\">{{ $('Extraer Datos de la Reserva').item.json.adults }} adulto(s), {{ $('Extraer Datos de la Reserva').item.json.children }} niño(s)</td></tr>\n      <tr><td style=\"padding:8px 0; border-bottom: 1px solid #f1f5f9;\"><strong>Punto de Recogida:</strong></td><td style=\"text-align: right;\">{{ $('Extraer Datos de la Reserva').item.json.pickupHotel }}</td></tr>\n      <tr><td style=\"padding:8px 0; border-bottom: 1px solid #f1f5f9;\"><strong>Contacto Cliente:</strong></td><td style=\"text-align: right;\">{{ $('Extraer Datos de la Reserva').item.json.customerName }} (Tel: {{ $('Extraer Datos de la Reserva').item.json.customerPhone }})</td></tr>\n      <tr><td style=\"padding:8px 0;\"><strong>N° de Reserva:</strong></td><td style=\"text-align: right; font-weight: bold;\">#{{ $('Extraer Datos de la Reserva').item.json.bookingId }}</td></tr>\n    </table>\n    <p style=\"margin-top: 16px; font-size: 13px; color: #64748b;\">Por favor confirmar la asignación de guía y transporte a través de su canal habitual.</p>\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "93ab38bf-ddef-48c0-9f41-613187f5bb0e",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1120, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true, \"status\": \"notified_provider\" } }}"
      }
    },
    {
      "id": "67fc56e4-9b3d-4e32-91b0-d6ffa63a82ea",
      "name": "Avisar Fallo de Notificación (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 192],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID || '-1002489148001' }}",
        "text": "=⚠️ No se pudo notificar por email al proveedor de la reserva {{ $('Extraer Datos de la Reserva').item.json.bookingId }}. Coordinar chofer/guía manualmente por WhatsApp.",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "e473fa3c-db3a-4d73-9adc-7908eec9733d",
      "name": "Responder OK (email falló)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1344, 192],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true, \"emailError\": true } }}"
      }
    },
    {
      "id": "c222443f-bde3-4afd-b8e8-78fd2463012b",
      "name": "Escalar Coordinación por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [896, 384],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID || '-1002489148001' }}",
        "text": "=📞 Coordinar logística manualmente con el proveedor — Reserva {{ $('Extraer Datos de la Reserva').item.json.bookingId }}\n• Tour: {{ $('Extraer Datos de la Reserva').item.json.tourName }} — {{ $('Extraer Datos de la Reserva').item.json.date }} a las {{ $('Extraer Datos de la Reserva').item.json.time }}\n• Proveedor: {{ $json.name || $('Extraer Datos de la Reserva').item.json.providerId }} (estado: {{ $json.status || 'desconocido' }})\n• Contacto proveedor: {{ $json.whatsapp || $json.phone || 'sin teléfono' }} ({{ $json.email || 'sin email' }})\n• Cliente: {{ $('Extraer Datos de la Reserva').item.json.customerName }} (Tel: {{ $('Extraer Datos de la Reserva').item.json.customerPhone }})",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "7f68749c-c070-4129-9ff9-8a5c85c11486",
      "name": "Responder OK (escalado)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1120, 384],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true, \"escalated\": true } }}"
      }
    }
  ]
}

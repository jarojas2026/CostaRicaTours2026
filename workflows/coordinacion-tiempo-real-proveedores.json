{
  "id": "1wf8ZQ1XuVTpbHnw",
  "name": "Coordinación en Tiempo Real con Proveedores",
  "active": false,
  "description": "Cuando se confirma una reserva, avisa en tiempo real al operador/proveedor asignado (email si está activo, o escala inmediatamente a Telegram si es prospecto o requiere coordinación manual) para asegurar guía, transporte y logística de inmediato.",
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Costa_Rica",
    "errorWorkflow": "CRT-ERR-01"
  },
  "connections": {

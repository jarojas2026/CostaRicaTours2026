{
  "id": "Er8taaV6RsA539xp",
  "name": "Solicitud de Reseña Post-Tour",
  "active": false,
  "description": "Cada día a las 5pm busca tours confirmados de ese mismo día (ya finalizados) y envía una solicitud de reseña por email, marcando reviewRequestSent para no repetir el envío.",
  "settings": { "executionOrder": "v1" },
  "connections": {
    "Disparador Diario 5pm (Costa Rica)": { "main": [[{ "node": "Buscar Reservas Confirmadas", "type": "main", "index": 0 }]] },
    "Buscar Reservas Confirmadas": { "main": [[{ "node": "Filtrar Tours de Hoy", "type": "main", "index": 0 }]] },
    "Filtrar Tours de Hoy": { "main": [[{ "node": "Bucle Reservas de Hoy", "type": "main", "index": 0 }]] },
    "¿Reserva Tiene Email?": { "main": [[{ "node": "Enviar Solicitud de Reseña", "type": "main", "index": 0 }], [{ "node": "Bucle Reservas de Hoy", "type": "main", "index": 0 }]] },
    "Enviar Solicitud de Reseña": { "main": [[{ "node": "Preparar Actualización", "type": "main", "index": 0 }], [{ "node": "Avisar Fallo de Solicitud (Telegram)", "type": "main", "index": 0 }]] },
    "Preparar Actualización": { "main": [[{ "node": "Marcar Reseña Solicitada", "type": "main", "index": 0 }]] },
    "Marcar Reseña Solicitada": { "main": [[{ "node": "Bucle Reservas de Hoy", "type": "main", "index": 0 }]] },
    "Bucle Reservas de Hoy": { "main": [[], [{ "node": "¿Reserva Tiene Email?", "type": "main", "index": 0 }]] },
    "Avisar Fallo de Solicitud (Telegram)": { "main": [[{ "node": "Bucle Reservas de Hoy", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    { "id": "bdabe5c7-05a9-4ed7-b5cf-b7cba187447e", "name": "Disparador Diario 5pm (Costa Rica)", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.4, "position": [0, 384], "parameters": { "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 17, "triggerAtMinute": 0 }] } } },
    { "id": "c1af5bd1-48da-4718-bedc-dbfc5e89e3e8", "name": "Buscar Reservas Confirmadas", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [224, 384], "parameters": { "resource": "document", "operation": "query", "authentication": "serviceAccount", "projectId": "PENDIENTE_CONFIGURAR_ID_PROYECTO_FIREBASE", "query": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"bookings\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"confirmada\"}}}}}", "simple": true } },
    { "id": "fb4bb266-2ca1-4c88-bf39-20ba6d4a4b73", "name": "Filtrar Tours de Hoy", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [448, 384], "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const hoyStr = new Date().toISOString().slice(0, 10);\n\nreturn $input.all()\n  .filter(i => Object.keys(i.json).length > 0)\n  .filter(i => (i.json.reviewRequestSent || false) !== true)\n  .filter(i => {\n    const fecha = String(i.json.date || '').slice(0, 10);\n    return fecha === hoyStr;\n  })\n  .map(i => ({ json: i.json }));" } },
    { "id": "eae44fdc-5a0d-4508-a5e1-7d7bd7aeb391", "name": "¿Reserva Tiene Email?", "type": "n8n-nodes-base.if", "typeVersion": 2.3, "position": [896, 96], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.customer.email }}", "operator": { "type": "string", "operation": "notEmpty" } }] } } },
    { "id": "990a76d8-8d8d-4a27-b0a4-f67762d62afb", "name": "Enviar Solicitud de Reseña", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [1120, 96], "parameters": { "resource": "message", "operation": "send", "sendTo": "={{ $json.customer.email }}", "subject": "=¿Qué tal estuvo tu tour, {{ $json.customer.name }}? 🌴", "emailType": "html", "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color:#0A2315;\">¡Pura Vida, {{ $json.customer.name }}!</h2>\n  <p>Esperamos que hayas disfrutado muchísimo tu experiencia en <strong>{{ $json.tourName }}</strong>.</p>\n  <p>Tu opinión nos ayuda a mejorar y ayuda a otros viajeros a decidir su próxima aventura en Costa Rica. ¿Nos regalas 2 minutos para contarnos cómo te fue?</p>\n  <p style=\"margin: 24px 0; text-align:center;\">\n    <a href=\"PENDIENTE_CONFIGURAR_LINK_DE_RESENA\" style=\"background:#0A2315;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;\">Dejar mi reseña</a>\n  </p>\n  <p style=\"color:#888; font-size:12px;\">Gracias por elegirnos. Costa Rica Tours — 100% Tico</p>\n</div>", "options": { "appendAttribution": false } }, "onError": "continueErrorOutput" },
    { "id": "a1141471-c768-48a5-aaa2-7536fc641c49", "name": "Preparar Actualización", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [1344, 0], "parameters": { "mode": "manual", "assignments": { "assignments": [{ "id": "a-id", "name": "id", "type": "string", "value": "={{ $('Bucle Reservas de Hoy').item.json.bookingId }}" }, { "id": "a-sent", "name": "reviewRequestSent", "type": "boolean", "value": true }, { "id": "a-at", "name": "reviewRequestSentAt", "type": "string", "value": "={{ $now.toISO() }}" }] } } },
    { "id": "5cc9e555-e885-48bd-9f25-2bf40db4375b", "name": "Marcar Reseña Solicitada", "type": "n8n-nodes-base.googleFirebaseCloudFirestore", "typeVersion": 1.1, "position": [1568, 176], "parameters": { "resource": "document", "operation": "upsert", "authentication": "serviceAccount", "projectId": "PENDIENTE_CONFIGURAR_ID_PROYECTO_FIREBASE", "collection": "bookings", "updateKey": "id", "columns": "id,reviewRequestSent,reviewRequestSentAt" } },
    { "id": "833dbbaa-b808-4e43-9442-9f819a0719ee", "name": "Bucle Reservas de Hoy", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [672, 384], "parameters": { "batchSize": 1 } },
    { "id": "eb3f5922-8a26-43ea-8e9f-417145f89ebf", "name": "Avisar Fallo de Solicitud (Telegram)", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [1344, 192], "parameters": { "resource": "message", "operation": "sendMessage", "chatId": "PENDIENTE_CONFIGURAR_CHAT_ID", "text": "=⚠️ No se pudo enviar la solicitud de reseña de la reserva {{ $('Bucle Reservas de Hoy').item.json.bookingId }}.", "additionalFields": { "appendAttribution": false } } }
  ]
}

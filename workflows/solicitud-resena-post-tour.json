  "nodes": [
    {
      "id": "bdabe5c7-05a9-4ed7-b5cf-b7cba187447e",
      "name": "Disparador Diario 5pm (Costa Rica)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 384],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "c1af5bd1-48da-4718-bedc-dbfc5e89e3e8",
      "name": "Buscar Reservas Confirmadas",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [224, 384],
      "parameters": {
        "resource": "document",
        "operation": "query",
        "authentication": "serviceAccount",
        "projectId": "gen-lang-client-0782739149",
        "query": "{\"structuredQuery\":{\"from\":[{\"collectionId\":\"bookings\"}],\"where\":{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"confirmada\"}}}}}",
        "simple": true
      }
    },
    {
      "id": "fb4bb266-2ca1-4c88-bf39-20ba6d4a4b73",
      "name": "Filtrar Tours de Hoy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 384],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const hoyStr = new Date().toISOString().slice(0, 10);\n\nreturn $input.all()\n  .filter(i => Object.keys(i.json).length > 0)\n  .filter(i => (i.json.reviewRequestSent || false) !== true)\n  .filter(i => {\n    const fecha = String(i.json.date || '').slice(0, 10);\n    return fecha === hoyStr;\n  })\n  .map(i => ({ json: i.json }));"
      }
    },
    {
      "id": "833dbbaa-b808-4e43-9442-9f819a0719ee",
      "name": "Bucle Reservas de Hoy",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [672, 384],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "eae44fdc-5a0d-4508-a5e1-7d7bd7aeb391",
      "name": "¿Reserva Tiene Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [896, 96],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.customer?.email || $json.customerEmail }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "990a76d8-8d8d-4a27-b0a4-f67762d62afb",
      "name": "Enviar Solicitud de Reseña",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1120, 96],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.customer?.email || $json.customerEmail }}",
        "subject": "=🌿 ¿Cómo estuvo tu experiencia en {{ $json.tourName }}? - Costa Rica Tours",
        "emailType": "html",
        "message": "=\n<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #1e293b; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;\">\n  <div style=\"background: linear-gradient(135deg, #059669, #047857); padding: 24px; text-align: center; color: white;\">\n    <h2 style=\"margin: 0;\">¡Pura Vida, {{ $json.customer?.name || $json.customerName || 'Viajero' }}! 🌴</h2>\n    <p style=\"margin: 6px 0 0 0; opacity: 0.95;\">Esperamos que hayas vivido momentos inolvidables</p>\n  </div>\n  <div style=\"padding: 24px;\">\n    <p>Esperamos que hayas disfrutado muchísimo tu experiencia en <strong>{{ $json.tourName }}</strong>.</p>\n    <p>Tu opinión sincera apoya directamente a los guías locales y a las familias de las comunidades que hacen posible este turismo sostenible. Además, ayuda a otros viajeros del mundo a preparar su aventura.</p>\n    <p style=\"margin: 28px 0; text-align: center;\">\n      <a href=\"https://costaricatours.com/resenas?bookingId={{ $('Bucle Reservas de Hoy').item.json.bookingId }}\" style=\"background: #059669; color: #ffffff; padding: 14px 28px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-block; box-shadow: 0 4px 6px -1px rgba(5,150,105,0.2);\">\n        ⭐ Dejar mi reseña y valoración\n      </a>\n    </p>\n    <p style=\"font-size: 13px; color: #64748b; line-height: 1.5;\">Solo toma 2 minutos y tu guía te lo agradecerá profundamente.</p>\n  </div>\n  <div style=\"background: #f1f5f9; padding: 12px; text-align: center; font-size: 11px; color: #64748b;\">\n    Costa Rica Tours — Turismo Sostenible Certificado · 100% Pura Vida\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a1141471-c768-48a5-aaa2-7536fc641c49",
      "name": "Preparar Actualización",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1344, 0],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a-id",
              "name": "id",
              "type": "string",
              "value": "={{ $('Bucle Reservas de Hoy').item.json.bookingId }}"
            },
            {
              "id": "a-sent",
              "name": "reviewRequestSent",
              "type": "boolean",
              "value": true
            },
            {
              "id": "a-at",
              "name": "reviewRequestSentAt",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      }
    },
    {
      "id": "5cc9e555-e885-48bd-9f25-2bf40db4375b",
      "name": "Marcar Reseña Solicitada",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [1568, 176],
      "parameters": {
        "resource": "document",
        "operation": "upsert",
        "authentication": "serviceAccount",
        "projectId": "gen-lang-client-0782739149",
        "collection": "bookings",
        "updateKey": "id",
        "columns": "id,reviewRequestSent,reviewRequestSentAt"
      }
    },
    {
      "id": "eb3f5922-8a26-43ea-8e9f-417145f89ebf",
      "name": "Avisar Fallo de Solicitud (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1344, 192],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID || '-1002489148001' }}",
        "text": "=⚠️ No se pudo enviar por email la solicitud de reseña de la reserva {{ $('Bucle Reservas de Hoy').item.json.bookingId }}.",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ]
}

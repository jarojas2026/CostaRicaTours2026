        "jsCode": "const b = $input.first().json.body || $input.first().json || {}; const subtotal = parseFloat(b.subtotalUSD) || 100.0; const tasaIVA = 0.04; const montoIVA = subtotal * tasaIVA; const canonReserva = 2.50; const totalFinal = subtotal + montoIVA + canonReserva; return [{ json: { ...b, subtotalUSD: subtotal.toFixed(2), tasaIVA: \"4% (Tarifa Reducida Turismo Nacional Ley 9635)\", montoIVAUSD: montoIVA.toFixed(2), canonConservacionParques: canonReserva.toFixed(2), totalFacturadoUSD: totalFinal.toFixed(2), statusTributario: \"CUMPLIMIENTO_TRIBUTARIO_MINISTERIO_HACIENDA_CR\" } }];"
